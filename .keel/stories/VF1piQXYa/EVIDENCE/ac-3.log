title: Everyday Keel
description: Use Keel day to day without losing the turn-based rhythm that keeps the board trustworthy.
---

import SignalGrid from '@site/src/components/SignalGrid';
import TurnCycle from '@site/src/components/TurnCycle';

export const dailySignals = [
  {
